# ============================================
# LinkinAutomator Configuration
# ============================================

# -------------------- Authentication --------------------
# Your LinkedIn login credentials
LINKEDIN_USERNAME=your_email@example.com
LINKEDIN_PASSWORD=your_secure_password

# -------------------- Search Settings --------------------
# What to search for (job title, company, keywords, location, etc.)
# Examples: "Software Engineer", "Product Manager at Google", "Recruiter in New York"
SEARCH_KEYWORDS=Software Engineer

# How many profiles to process (max connections per run)
SEARCH_LIMIT=20

# -------------------- Connection Settings --------------------
# Message to send with connection requests (leave empty for no note)
# Keep it short and professional (max 300 characters)
# CONNECTION_MESSAGE=Hi! I'd love to connect and learn more about your work.

# -------------------- Operation Mode --------------------
# Browser visibility: false = show browser, true = run in background
HEADLESS=false

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# Data directory for storing history
DATA_DIR=./data

# -------------------- Stealth & Timing --------------------
# Minimum delay between actions (seconds)
MIN_DELAY=2

# Maximum delay between actions (seconds)
MAX_DELAY=5
